{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
            "cacheVariables": {
                "GP_ENABLE_CAN": "OFF",
                "GP_ENABLE_ACTUATION": "OFF",
                "GP_UNPOWERED_SIGNAL_TEST": "OFF",
                "GP_ENABLE_WATCHDOG": "OFF",
                "GP_DIRECT_COMMANDS": "OFF",
                "GP_BOARD_APPROVAL_HEADER": "",
                "GP_CONTROLLED_BENCH_ACTUATION": "OFF"
            }
        },
        {
            "name": "Debug",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release-base",
            "hidden": true,
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "Release",
            "inherits": "BenchActuationRelease"
        },
        {
            "name": "SafeFlash",
            "inherits": "Debug",
            "cacheVariables": {
                "GP_ENABLE_CAN": "OFF",
                "GP_ENABLE_ACTUATION": "OFF",
                "GP_ENABLE_WATCHDOG": "OFF",
                "GP_BOARD_APPROVAL_HEADER": ""
            }
        },
        {
            "name": "CanBench",
            "inherits": "Debug",
            "cacheVariables": {
                "GP_ENABLE_CAN": "ON",
                "GP_ENABLE_ACTUATION": "OFF",
                "GP_ENABLE_WATCHDOG": "OFF",
                "GP_BOARD_APPROVAL_HEADER": "${sourceDir}/App/Profiles/can_bench.h"
            }
        },
        {
            "name": "CanBenchRelease",
            "displayName": "CAN + full-range dual-axis commissioning (Release)",
            "description": "Direct valid CAN demand without ARM/DEADMAN or neutral arming. Outputs can start on the first command. CanBench stays receive-only.",
            "inherits": "BenchActuationRelease",
            "cacheVariables": {
                "GP_DIRECT_COMMANDS": "ON"
            }
        },
        {
            "name": "SteeringBenchRelease",
            "displayName": "Direct CAN, low-speed steering diagnostic (Release)",
            "description": "86CM85 diagnostic: full signed steering demand maps to 1000 STEP/s; 200 STEP/s/s ramp. Throttle unchanged. Bench settings are physically unverified.",
            "inherits": "CanBenchRelease",
            "cacheVariables": {
                "GP_BOARD_APPROVAL_HEADER": "${sourceDir}/App/Profiles/steering_bench.h"
            }
        },
        {
            "name": "SignalTest",
            "inherits": "Debug",
            "cacheVariables": {
                "GP_ENABLE_CAN": "ON",
                "GP_ENABLE_ACTUATION": "ON",
                "GP_UNPOWERED_SIGNAL_TEST": "ON",
                "GP_ENABLE_WATCHDOG": "OFF",
                "GP_BOARD_APPROVAL_HEADER": "${sourceDir}/App/Profiles/signal_test.h"
            }
        },
        {
            "name": "SignalTestRelease",
            "inherits": "release-base",
            "cacheVariables": {
                "GP_ENABLE_CAN": "ON",
                "GP_ENABLE_ACTUATION": "ON",
                "GP_UNPOWERED_SIGNAL_TEST": "ON",
                "GP_ENABLE_WATCHDOG": "OFF",
                "GP_BOARD_APPROVAL_HEADER": "${sourceDir}/App/Profiles/signal_test.h"
            }
        },
        {
            "name": "BenchActuation",
            "inherits": "Debug",
            "cacheVariables": {
                "GP_ENABLE_CAN": "ON",
                "GP_ENABLE_ACTUATION": "ON",
                "GP_UNPOWERED_SIGNAL_TEST": "OFF",
                "GP_CONTROLLED_BENCH_ACTUATION": "ON",
                "GP_ENABLE_WATCHDOG": "OFF",
                "GP_BOARD_APPROVAL_HEADER": "${sourceDir}/App/Profiles/bench_actuation.h"
            }
        },
        {
            "name": "BenchActuationRelease",
            "inherits": "release-base",
            "cacheVariables": {
                "GP_ENABLE_CAN": "ON",
                "GP_ENABLE_ACTUATION": "ON",
                "GP_UNPOWERED_SIGNAL_TEST": "OFF",
                "GP_CONTROLLED_BENCH_ACTUATION": "ON",
                "GP_ENABLE_WATCHDOG": "OFF",
                "GP_BOARD_APPROVAL_HEADER": "${sourceDir}/App/Profiles/bench_actuation.h"
            }
        },
        {
            "name": "Commissioning",
            "inherits": "BenchActuationRelease"
        }
    ],
    "buildPresets": [
        {
            "name": "SteeringBenchRelease",
            "configurePreset": "SteeringBenchRelease"
        },
        {
            "name": "Debug",
            "configurePreset": "Debug"
        },
        {
            "name": "Release",
            "configurePreset": "Release"
        },
        {
            "name": "SafeFlash",
            "configurePreset": "SafeFlash"
        },
        {
            "name": "CanBench",
            "configurePreset": "CanBench"
        },
        {
            "name": "CanBenchRelease",
            "configurePreset": "CanBenchRelease"
        },
        {
            "name": "SignalTest",
            "configurePreset": "SignalTest"
        },
        {
            "name": "SignalTestRelease",
            "configurePreset": "SignalTestRelease"
        },
        {
            "name": "BenchActuation",
            "configurePreset": "BenchActuation"
        },
        {
            "name": "BenchActuationRelease",
            "configurePreset": "BenchActuationRelease"
        },
        {
            "name": "Commissioning",
            "configurePreset": "Commissioning"
        }
    ]
}
